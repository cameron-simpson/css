from cs.cmdutils import BaseCommand, GetoptError, popopts
from cs.ffmpegutils import ffmpeg_exe, ffprobe
from cs.fstags import FSTags,uses_fstags
from cs.logutils import info, warning
from cs.pfx import Pfx, pfx_call
from cs.printt import printt
from cs.psutils import run

def main(argv=None):
  return FFPickCommand(argv).run()

class TimeSpan(namedtuple('TimeSpan', 'start_time end_time')):
  ''' An object with `.start_time` and `.end_time` attributes
      used as `Picker` match results.
  '''

class Picker(ABC):

  def __init__(
      self,
      match_func: Callable[[dict], Any],
      *,
      exclude: bool = False,
  ):
    self.match_func = match_func
    self.exclude = bool(exclude)

  @classmethod
  def from_str(cls, pick_spec: str, /, *, exclude=False) -> Self:
    try:
      return TimePick.from_str(pick_spec)
    except ValueError:
      pass
    pick_by, pattern = pick_spec.split(':', 1)
    if pick_by == 'chapter':
      return ChapterPick.from_str(pattern, exclude=exclude)
    raise ValueError(f'unhandled {pick_by=}')

  @abstractmethod
  def matches(self, probed: dict, *, exclude=False) -> Iterable:
    ''' Match this `Pikcer` against `probed`, the `dict` returned by `ffprobe()`.
        Return an interable of matches.
    '''
    raise NotImplementedError

  def matches_timespans(self,
                        probed,
                        *,
                        invert=False) -> Iterable[Tuple[float, float]]:
    ''' Match against `probed`, the return from `ffprobe`.
        Return `(start_time,end_time)` 2-tuples.

        This default implementation expects `matches` to produce
        objects with `.start_time` and `.end_time` attributes being
        time offsets in seconds.
    '''
    for chapter in self.matches(probed, invert=invert):
      yield float(chapter.start_time), float(chapter.end_time)

class ChapterPick(Picker):

  def __str__(self):
    return f'{"!" if self.exclude else ""}chapter:{self.match_func}'

  @classmethod
  def from_str(cls, pattern: str, /, *, exclude=False) -> Self:
    if pattern.startswith('/'):
      chap_re = re.compile(pattern[1:], re.IGNORECASE)
      match_func = lambda ch: chap_re.search(ch['tags']['title'])
    else:
      raise ValueError(f'unrecognised {pattern=}')
    return cls(match_func, exclude=exclude)

  def matches(self, probed, *, invert=False) -> Iterable:
    ''' Match against `probed`, the return from `ffprobe`.
        Return chapter objects, which have `.start_time` and
        `.end_time` attributes.
    '''
    exclude = bool(invert) ^ bool(self.exclude)
    for chapter in probed['chapters']:
      if bool(self.match_func(chapter)) ^ exclude:
        yield chapter

class TimePick(Picker):
  ''' A `Picker` subclass for start..end timespans.
  '''

  #                    [start:float]          ..  [end:float]
  span_re = re.compile(r'(?P<start>\d+(\.\d*)?)?\.\.(?P<end>\d+(\.\d*)?)?')

  def __init__(self, start, end, exclude=False):
    if end is not ... and end < start:
      raise ValueError(f'{start=} > {end=}')
    self.start = start
    self.end = end
    self.exclude = exclude

  def __str__(self):
    return (
        ("!" if self.exclude else "") + (
            f'{self.start}..'
            if self.end is ... else f'{self.start}..{self.end}'
        )
    )

  @classmethod
  def from_str(cls, pattern: str, /, *, exclude=False) -> Self:
    if not (m := cls.span_re.match(pattern)) or m.end() != len(pattern):
      raise ValueError(
          f'{cls.__name__}: {pattern=} does not match {cls.span_re.pattern!r}'
      )
    start = m.group('start')
    start = float(start) if start else 0.0
    end = m.group('end')
    end = float(end) if end else ...
    return cls(start=start, end=end, exclude=exclude)

  def matches(self, probed, *, invert=False) -> Iterable:
    ''' Match against `probed`, the return from `ffprobe`.
        Return chapter objects, which have `.start_time` and
        `.end_time` attributes.
    '''
    exclude = bool(invert) ^ bool(self.exclude)
    duration = float(probed["format"]["duration"])
    if duration < 0.0:
      raise ValueError(f'probed {duration=} < 0.0')
    start = self.start
    end = duration if self.end is ... else self.end
    pos = 0.0
    if pos < start:
      npos = min(start, duration)
      if exclude:
        yield TimeSpan(pos, npos)
      pos = npos
    if pos < end:
      npos = min(end, duration)
      if not exclude:
        yield TimeSpan(pos, npos)
      pos = npos
    if pos < duration:
      npos = duration
      if exclude:
        yield TimeSpan(pos, npos)

@uses_fstags
def pick(
    mediafile: str,
    *pickers,
    fstags:FSTags,
    annotation: str | None,
    outdirpath: str | None = None,
    outputpath: str | None = None,
    prefix_re: str | re.Pattern | None = None,
    exists_ok: bool = False,
    keep_failed_output=False,
) -> str:
  ''' Pick subsections from `mediafile` using `pickers` and write a
      new media file to `outputpath`.
      Return the output filesystem path.

      Parameters:
      * `mediafile`: the source media file
      * `annotation`: an optional annotation string to insert into
        a generated `outputpath`, default `"--picked"`
      * `outdirpath`: optional directory component of a generated
        `outputpath`, default `dirname(mediafile)`
      * `outputpath`: optional output media file path, generated
        if not specified
      * `prefix_re`: optional regular expression to match a prefix
        of the mediafile basename used when generating an outputpath
      * `exists_ok`: if false, raise an error if the outputpath
        already exists
      * `keep_failed_output`: if true, do not remove the outputpath
        if `ffmpeg` fails

      A generated outputpath is made as:
          {outdirpath}/{prefix}{annotation}{suffix}{extension}
      where:
      - the `mediafile` basename is split into {mediabase} and the
        file extension
      - the `prefix` is obtained by matching `prefix_re` against
        {mediabase}, unless `prefix_re` is not speciied in which case
        the entire {mediabase} is used
      - the `suffix` is the portion of {mediabase} after the {prefix}
  '''
  with Pfx(f'pick({mediafile=},...)'):
    if not existspath(mediafile):
      raise ValueError(f'missing {mediafile=}')
    if annotation is None:
      annotation = '--picked'
    media_prefix, media_suffix = splitext(mediafile)
    media_base = basename(media_prefix)
    if not outputpath:
      # compute a default outputpath
      if outdirpath is None or outdirpath == '':
        outdirpath = dirname(media_prefix)
      if prefix_re is None:
        outprefix = media_prefix
        outsuffix = ''
      else:
        if not isinstance(prefix_re, re.Pattern):
          prefix_re = pfx_call(re.compile, prefix_re)
        if (m := prefix_re.match(media_base)) is None:
          raise ValueError(f'{prefix_re=} does not match {media_base=}')
        outprefix = m.group()
        outsuffix = media_base[m.end():]
      outbase = f'{outprefix}{annotation}{outsuffix}{media_suffix}'
      assert os.sep not in outbase
      outputpath = joinpath(outdirpath, outbase)
    try:
      if samefile(mediafile, outputpath):
        raise ValueError(
            'input and output are the same file'
            f': {mediafile=} {outputpath=}'
        )
    except FileNotFoundError:
      pass
    if not exists_ok and existspath(outputpath):
      raise ValueError(f'{outputpath=} already exists')
    probed = ffprobe(mediafile)
    pprint(probed, indent=2)
    if chapters := probed.get('chapters'):
      printt(
          "chapter:",
          {ch['id']: ch
           for ch in sorted(chapters, key=lambda ch: ch['id'])}
      )
    print(f'{pickers=}')
    # prepare the basis of each ffmpeg invocation
    exe = ffmpeg_exe()
    ffargv0 = [exe, ('-loglevel', 'repeat+error'), '-nostdin']
    if exists_ok:
      ffargv0.append('-y')
    ffargv0 = tuple(ffargv0)
    # TODO: can I use a Range here, to overlap the timespans?
    #       no, Ranges think they're ints at present
    timespans = []
    for picker in pickers:
      timespans.extend(picker.matches_timespans(probed))
    if not timespans:
      raise ValueError("no timespans pickered")
    clips = []
    try:
      for i, (start_time, end_time) in enumerate(timespans):
        ##clippath = joinpath(dirpath, f'{media_base}--{i:02d}.ts')
        ##clippath = f'{media_base}--{i:02d}.ts'
        clipfd, clippath = mkstemp(
            prefix=f'{media_base}--{i:02d}--', suffix='.ts'
        )
        clips.append(clippath)
        os.close(clipfd)
        clip_argv = [
            *ffargv0,
            '-y',
            ('-ss', str(start_time)),
            ('-to', str(end_time)),
            '-noaccurate_seek',
            ('-i', mediafile),
            ('-c', 'copy'),
            clippath,
        ]
        run(clip_argv, fold=True)
      ##clips_spec='|'.join(f"'{clippath}'" for clippath in clips)
      clips_spec = '|'.join(clips)
      ffargv = [
          *ffargv0,
          exists_ok and '-y',
          ('-i', f'concat:{clips_spec}'),
          ('-i', mediafile),
          ('-map', '0'),
          ('-map_metadata', '1'),
          ('-map_chapters', '-1'),  # strip chapters
          ('-c', 'copy'),
          outputpath,
      ]
      try:
        run(ffargv, fold=True)
        fstags[outputpath].update(fstags[mediafile])
      except CalledProcessError as e:
        print(f'FAILED: {e}')
        breakpoint()
        if keep_failed_output:
          if existspath(outputpath):
            info(f'failed output present at {outputpath=}')
            fstags[outputpath].update(fstags[mediafile])
        else:
          try:
            pfx_call(os.remove, outputpath)
          except FileNotFoundError:
            pass
        raise
    finally:
      for clippath in clips:
        try:
          pfx_call(os.remove, clippath)
        except FileNotFoundError as e:
          warning(f'tmep clip file {clippath=}: {e}')
    return outputpath

class FFPickCommand(BaseCommand):
  ''' Pick subsections of a media file.
  '''

  def poppick(self, argv) -> Picker:
    ''' Pop the first item from `argv` and return it as a `Picker` instanc.
    '''
    if not argv:
      raise GetoptError("missing pick")
    pick = argv.pop(0)
    with Pfx('pick %s', pick):
      exclude = False
      if pick.startswith('-'):
        exclude = True
        pick = pick[1:]
      try:
        return Picker.from_str(pick, exclude=exclude)
      except ValueError as e:
        raise GetoptError(f'invalid pick: {e}') from e

  @popopts(
      A_=(
          'annotation',
          'Annotation string to append after the prefix, default "--picked".'
      ),
      d_=('outdirpath', 'Output file directory.'),
      o_=('outputpath', 'Output filename.'),
      P_=('prefix_re_s', 'Mediafile prefix regexp, default ".*"'),
      y=('overwrite', 'Overwrite the output file.'),
  )
  def main(self, argv):
    ''' Usage: {cmd} mediafile [picks...]
          Scan mediafile and report pickable things.
    '''
    options = self.options
    if not argv:
      raise GetoptError("missing mediafile")
    mediafile = argv.pop(0)
    if not argv:
      probed = ffprobe(mediafile)
      pprint(probed, indent=2)
      if chapters := probed.get('chapters'):
        printt(
            "chapter:",
            {ch['id']: ch
             for ch in sorted(chapters, key=lambda ch: ch['id'])}
        )
      return 0
    pickers = []
    while argv:
      picker = self.poppick(argv)
      print(picker)
      pickers.append(picker)
    print(f'{pickers=}')
    annotation = options.annotation
    if annotation is None:
      annotation = "--" + ",".join(map(str, pickers))
    try:
      outputpath = pick(
          mediafile,
          *pickers,
          annotation=annotation,
          outdirpath=options.outdirpath,
          outputpath=options.outputpath,
          prefix_re=options.prefix_re_s,
          exists_ok=bool(options.overwrite),
          keep_failed_output=True,
      )
    except ValueError as e:
      warning(f'picker failed: {e}')
      raise
      return 1
    print(outputpath)
    return 0

if __name__ == '__main__':
  sys.exit(main(sys.argv))
